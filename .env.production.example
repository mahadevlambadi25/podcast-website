# Copy to .env.production on the server and fill in values. Never commit .env.production.
# Generate secrets with:  openssl rand -hex 32

# Public URL (http://<SERVER_IP> until a domain is set up). Baked into the build.
NEXT_PUBLIC_SITE_URL=http://YOUR_SERVER_IP
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Database password (hex only, so it is safe inside the connection URL)
POSTGRES_PASSWORD=

SESSION_SECRET=
CRON_SECRET=

# Creates the first admin only when the database has no users
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email (Resend)
RESEND_API_KEY=
NOMINATION_RECIPIENT_EMAIL=
CONTACT_RECIPIENT_EMAIL=
SMTP_FROM=
NOMINATION_WEBHOOK_URL=

# Optional distributed rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

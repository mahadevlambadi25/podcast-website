# ==============================================================================
# "Unchartered: Legends & Legacies" Environment Variables
# Copy to .env.local for local development. Never commit sensitive values.
# ==============================================================================

# Server & Public Site Configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication & Session Security
# Generate a secure 64-character key: openssl rand -hex 32
SESSION_SECRET=replace-with-a-secure-random-64-character-hex-string
PAYLOAD_SECRET=replace-with-a-secure-random-32-character-secret-key

# Database Connection (SQLite / LibSQL)
# Local file: file:./payload.db
# Remote Turso: libsql://[your-db].turso.io
DATABASE_URI=file:./payload.db
# DATABASE_AUTH_TOKEN=your-turso-auth-token-if-using-remote-turso

# Scheduled Publishing Cron Secret (protects POST /api/cron/publish)
# Bearer token for triggering publication of scheduled episodes
CRON_SECRET=replace-with-a-secure-random-32-character-cron-token

# Email Service (Resend)
# Used for guest nomination notifications and audience contact inquiries
RESEND_API_KEY=
NOMINATION_RECIPIENT_EMAIL=nominations@uncharteredpodcast.com
CONTACT_RECIPIENT_EMAIL=contact@uncharteredpodcast.com

# Optional CRM Webhook (HubSpot, Slack, Zapier)
NOMINATION_WEBHOOK_URL=

# Privacy-Consented Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Durable Media Storage (AWS S3 or Cloudflare R2)
# Set S3_ENABLED=true for production object storage
S3_ENABLED=false
S3_BUCKET=unchartered-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
